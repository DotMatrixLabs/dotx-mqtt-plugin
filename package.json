{
  "name": "dotx-mqtt-plugin",
  "version": "1.0.1",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "build": "esbuild main.ts --bundle --outfile=main.js --format=cjs --platform=node --target=node16 --minify",
    "dev": "esbuild main.ts --bundle --outfile=main.js --format=cjs --platform=node --target=node16 --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "npm run build && dotx-plugin package",
    "release:verify-version": "dotx-plugin verify-release",
    "release:build": "npm run release:verify-version && npm run typecheck && npm run package"
  },
  "author": "Andreas Frøyland",
  "license": "MIT",
  "description": "MQTT Publisher with Home Assistant integration for Dot X",
  "repository": {
    "type": "git",
    "url": "https://github.com/DotMatrixLabs/dotx-mqtt-plugin.git"
  },
  "dependencies": {
    "@dotmatrixlabs/dotx-plugin-sdk": "^1.1.6",
    "mqtt": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
